FROM python:3.11-slim

WORKDIR /app

COPY pyproject.toml ./
# Install dependencies only (no editable install — source comes via volume mount)
RUN pip install --no-cache-dir \
    "fastapi>=0.110,<0.120" \
    "uvicorn[standard]>=0.29,<0.40" \
    "pydantic>=2.6,<3" \
    "pydantic-settings>=2.2,<3" \
    "sqlalchemy[asyncio]>=2.0,<3" \
    "aiosqlite>=0.19,<0.21" \
    "alembic>=1.13,<2" \
    "httpx>=0.27,<0.30" \
    "docker>=7.0,<8" \
    "pathspec>=0.12,<0.13" \
    "watchfiles>=0.21,<1" \
    "apscheduler>=3.10,<4" \
    "anthropic>=0.40,<1" \
    "openai>=1.0,<2" \
    "python-multipart>=0.0.9" \
    "requests>=2.31,<3" \
    "pytest>=8,<9" \
    "pytest-asyncio>=0.23,<1" \
    "pytest-cov>=4,<6" \
    "ruff>=0.4,<1"

# src/ comes in via volume mount at runtime; add it to the path
ENV PYTHONPATH=/app/src

EXPOSE 8000
