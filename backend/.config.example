# SMRT Agent — backend defaults for new projects
#
# Copy this file to `backend/.config`:
#   macOS / Linux:  cp backend/.config.example backend/.config
#   Windows:        copy backend\.config.example backend\.config
#
# These values are the **initial defaults** for any newly-registered project.
# Once a project exists, its per-project overrides live in
# <project>/.smrt/config.json and are managed via the Config tab in the web UI.
# Editing this file does NOT change config for already-registered projects.
#
# Loading order (later wins):
#   1. backend/.config           (this file — agent defaults)
#   2. .env                      (project-wide env, can override for local dev)
#   3. process environment       (export VAR=…, docker-compose env_file, etc.)
#
# `backend/.config` is gitignored. `backend/.config.example` is committed.

# ─── MODEL OVERRIDES (UI overrides these per-project) ──────
# Development: use Haiku (cheap). Switch to opus/sonnet for production.
SMRT_MODEL_REVIEWER=claude-haiku-4-5-20251001
SMRT_MODEL_QA=claude-haiku-4-5-20251001
SMRT_MODEL_CODER=claude-sonnet-4-6

# ─── LOOP CAPS (UI overrides these per-project) ────────────
SMRT_MAX_FIX_ATTEMPTS=3
SMRT_MAX_QUESTIONS_PER_ATTEMPT=2

# ─── UI DEFAULTS (UI overrides these per-project) ──────────
# Show agent thought-process stream by default for new projects.
SMRT_THOUGHT_PROCESS_MODE=true
