# SMRT Agent — environment configuration template
#
# Copy this file to `.env` and fill in real values:
#   macOS / Linux:  cp .env.example .env
#   Windows:        copy .env.example .env
#
# `.env` is gitignored. Never commit real secrets.

# ─── REQUIRED ───────────────────────────────────────────────
# Get one from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME

# ─── BUDGET GUARDRAILS ──────────────────────────────────────
# Hard halt if a single agent run exceeds this many USD.
SMRT_BUDGET_PER_RUN_USD=1.50
# Hard halt if total daily spend per project exceeds this.
SMRT_BUDGET_PER_DAY_USD=10.00

# ─── BIND ADDRESS (do not change unless you know why) ───────
# Localhost-only by default. Setting SMRT_BIND_HOST to 0.0.0.0
# exposes the UI to your local network. v1 has no auth — only
# safe behind a reverse proxy you set up yourself.
SMRT_BIND_HOST=127.0.0.1
SMRT_BACKEND_PORT=8000
SMRT_FRONTEND_PORT=5173

# ─── MODEL OVERRIDES (UI overrides these per-project) ──────
SMRT_MODEL_REVIEWER=claude-opus-4-7
SMRT_MODEL_QA=claude-sonnet-4-6
SMRT_MODEL_CODER=claude-sonnet-4-6

# ─── LOOP CAPS (UI overrides these per-project) ────────────
SMRT_MAX_FIX_ATTEMPTS=5
SMRT_MAX_QUESTIONS_PER_ATTEMPT=1

# ─── PATH ALLOWLIST (optional, off by default) ─────────────
# Comma-separated absolute paths. If set, project registration
# refuses paths outside these roots. Leave empty to allow any
# local path.
SMRT_PROJECT_ROOT_ALLOWLIST=

# ─── OBSERVABILITY ─────────────────────────────────────────
SMRT_LOG_LEVEL=INFO
