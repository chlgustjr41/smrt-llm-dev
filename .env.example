# SMRT Agent — environment configuration template
#
# Copy this file to `.env` and fill in real values:
#   macOS / Linux:  cp .env.example .env
#   Windows:        copy .env.example .env
#
# `.env` is gitignored. Never commit real secrets.

# ─── LLM PROVIDER ───────────────────────────────────────────
# Option A: Anthropic (cloud)
# Get one from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME

# Option B: Local LLM via LM Studio (or any OpenAI-compatible server)
# Set USE_LOCAL_LLM=true to prefer local over Anthropic.
# No API key is needed for LM Studio — leave LOCAL_LLM_API_KEY blank.
USE_LOCAL_LLM=false
# When running via Docker Compose, use host.docker.internal instead of localhost
# so the container can reach LM Studio on your host machine:
#   LOCAL_LLM_BASE_URL=http://host.docker.internal:1234/v1
LOCAL_LLM_BASE_URL=http://host.docker.internal:1234/v1
LOCAL_LLM_MODEL=local-model

# ─── BUDGET GUARDRAILS ──────────────────────────────────────
# Ceiling for a single Init Audit run or QA/Test Session.
SMRT_BUDGET_PER_RUN_USD=2.00
# Ceiling per ticket for the QA-Coder fix loop (resets on each fix attempt).
SMRT_BUDGET_PER_TICKET_USD=2.00
# Hard halt if total daily spend per project exceeds this.
SMRT_BUDGET_PER_DAY_USD=40.00

# ─── BIND ADDRESS (do not change unless you know why) ───────
# Localhost-only by default. Setting SMRT_BIND_HOST to 0.0.0.0
# exposes the UI to your local network. v1 has no auth — only
# safe behind a reverse proxy you set up yourself.
SMRT_BIND_HOST=127.0.0.1
SMRT_BACKEND_PORT=8000
SMRT_FRONTEND_PORT=5173

# ─── MODEL OVERRIDES (UI overrides these per-project) ──────
SMRT_MODEL_REVIEWER=claude-haiku-4-5-20251001
SMRT_MODEL_QA=claude-haiku-4-5-20251001
SMRT_MODEL_CODER=claude-sonnet-4-6

# ─── LOOP CAPS (UI overrides these per-project) ────────────
SMRT_MAX_FIX_ATTEMPTS=3
SMRT_MAX_QUESTIONS_PER_ATTEMPT=2

# ─── UI DEFAULTS (UI overrides these per-project) ──────────
# Show agent thought-process stream by default for new projects.
SMRT_THOUGHT_PROCESS_MODE=false

# ─── OBSERVABILITY ─────────────────────────────────────────
SMRT_LOG_LEVEL=INFO
